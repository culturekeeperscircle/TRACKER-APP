# TCKC Threat Tracker — API Keys Template
# Copy this file to `.env` and fill in your actual keys.
# The `.env` file is git-ignored; this `.env.example` is safe to commit.

ANTHROPIC_API_KEY=sk-ant-xxx
CONGRESS_API_KEY=xxx
COURTLISTENER_TOKEN=xxx
NEWS_API_KEY=xxx

# Source expansion 2026-05-07: register one key at https://api.data.gov/signup
# and use it for both regulations.gov v4 and govinfo.gov. The govinfo connector
# falls back to REGULATIONS_GOV_API_KEY when GOVINFO_API_KEY is unset, so
# setting one is sufficient.
REGULATIONS_GOV_API_KEY=
GOVINFO_API_KEY=

# ProPublica Congress (deferred Phase 2): https://www.propublica.org/datastore/api/propublica-congress-api
PROPUBLICA_CONGRESS_KEY=

# Supabase (path B: Supabase is the source of truth)
# Project ref defaults to xsqdjhjcqbawghuaqqwj; override only for staging.
SUPABASE_PROJECT_REF=xsqdjhjcqbawghuaqqwj
# Service role key bypasses RLS. Required for the daily workflow and any
# automation that writes. Get it from Studio -> Settings -> API.
# Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=
# Anon (publishable) key. Only useful if a permissive policy is open;
# the default RLS posture blocks it.
SUPABASE_ANON_KEY=
